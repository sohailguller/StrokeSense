/* B.E. F.A.S.T. */
"Stroke symptoms come on suddenly. If you notice any one of these signs, call 911 or your local emergency number immediately. Fast treatment can save brain function." = "Objawy udaru pojawiają się nagle. Jeśli zauważysz choć jeden z tych objawów, natychmiast zadzwoń pod numer alarmowy (np. 112 lub 911). Szybkie leczenie może uratować funkcje mózgu.";
"Sudden loss of balance or coordination, dizziness, or trouble walking." = "Nagła utrata równowagi lub koordynacji, zawroty głowy albo trudności z chodzeniem.";
"Sudden blurred or double vision, or loss of vision in one or both eyes." = "Nagłe niewyraźne lub podwójne widzenie albo utrata wzroku w jednym lub obu oczach.";
"One side of the face droops or feels numb. The smile may look uneven." = "Jedna strona twarzy opada lub drętwieje. Uśmiech może być krzywy.";
"Sudden weakness or numbness in an arm or leg, often on one side of the body." = "Nagłe osłabienie lub drętwienie ręki albo nogi, często po jednej stronie ciała.";
"Slurred speech, trouble speaking or understanding, or sudden confusion." = "Bełkotliwa mowa, trudności z mówieniem lub rozumieniem albo nagłe splątanie.";
"Call 911 right away, even if the symptoms go away. Note the time they started." = "Natychmiast zadzwoń pod numer alarmowy (np. 112 lub 911), nawet jeśli objawy miną. Zapamiętaj, o której się zaczęły.";

/* Types of stroke */
"Types of stroke" = "Rodzaje udaru";
"Strokes are caused either by a blockage or by bleeding. A TIA is a temporary warning." = "Udar jest spowodowany zatkaniem naczynia albo krwawieniem. TIA to przejściowe ostrzeżenie.";
"Ischemic stroke" = "Udar niedokrwienny";
"The most common type, about 87% of strokes." = "Najczęstszy rodzaj, około 87% udarów.";
"An ischemic stroke happens when a blood clot or narrowed artery blocks blood flow to part of the brain." = "Udar niedokrwienny występuje, gdy skrzep lub zwężona tętnica blokuje dopływ krwi do części mózgu.";
"Clot-dissolving medicine works best when given within a few hours of the first symptoms." = "Leki rozpuszczające skrzepy działają najlepiej, gdy poda się je w ciągu kilku godzin od pierwszych objawów.";
"Doctors may also remove large clots with a catheter (thrombectomy)." = "Lekarze mogą też usunąć duże skrzepy za pomocą cewnika (trombektomia).";
"Every minute counts, so call 911 or your local emergency number right away." = "Liczy się każda minuta, więc natychmiast zadzwoń pod numer alarmowy (np. 112 lub 911).";
"Hemorrhagic stroke" = "Udar krwotoczny";
"Less common, about 13% of strokes, but often more severe." = "Rzadszy, około 13% udarów, ale często cięższy.";
"A hemorrhagic stroke happens when a weakened blood vessel breaks and bleeds into or around the brain, raising pressure and damaging tissue." = "Udar krwotoczny występuje, gdy osłabione naczynie pęka i krwawi do mózgu lub wokół niego, co zwiększa ciśnienie i uszkadza tkankę.";
"High blood pressure is a common cause." = "Częstą przyczyną jest nadciśnienie.";
"Treatment may include lowering blood pressure and surgery to stop the bleeding or relieve pressure." = "Leczenie może obejmować obniżenie ciśnienia i operację, aby zatrzymać krwawienie lub zmniejszyć ucisk.";
"Aneurysms can be clipped or coiled to seal the vessel." = "Tętniaki można zamknąć klipsem lub spiralami (coils), aby uszczelnić naczynie.";
"Transient ischemic attack" = "Przemijający atak niedokrwienny";
"A \"mini-stroke\" with symptoms that go away." = "„Mini-udar”, którego objawy ustępują.";
"A TIA is a brief blockage of blood flow to the brain. Its symptoms are the same as a stroke but usually last only minutes." = "TIA to krótkie zablokowanie dopływu krwi do mózgu. Objawy są takie same jak przy udarze, ale zwykle trwają tylko kilka minut.";
"A TIA is a warning sign that a stroke may follow." = "TIA to sygnał ostrzegawczy, że może dojść do udaru.";
"It needs emergency care, even if the symptoms are gone." = "Wymaga pilnej pomocy, nawet jeśli objawy minęły.";
"Treating the cause can prevent a future stroke." = "Leczenie przyczyny może zapobiec udarowi w przyszłości.";

/* Risk factors */
"Risk factors" = "Czynniki ryzyka";
"Some conditions and habits make a stroke more likely. Many of them can be treated or changed." = "Niektóre choroby i nawyki zwiększają ryzyko udaru. Wiele z nich można leczyć lub zmienić.";
"High blood pressure" = "Nadciśnienie";
"The leading cause of stroke. Over time it damages and weakens blood vessels." = "Główna przyczyna udaru. Z czasem uszkadza i osłabia naczynia krwionośne.";
"Diabetes" = "Cukrzyca";
"High blood sugar damages blood vessels and makes clots more likely." = "Wysoki cukier we krwi uszkadza naczynia i sprzyja powstawaniu skrzepów.";
"Heart disease" = "Choroby serca";
"Conditions such as atrial fibrillation (AFib) can cause clots that travel to the brain." = "Choroby takie jak migotanie przedsionków mogą powodować skrzepy, które wędrują do mózgu.";
"Smoking" = "Palenie";
"Damages blood vessels and raises blood pressure." = "Uszkadza naczynia krwionośne i podnosi ciśnienie.";
"Sleep apnea" = "Bezdech senny";
"Repeated pauses in breathing during sleep strain the heart and blood vessels." = "Powtarzające się przerwy w oddychaniu podczas snu obciążają serce i naczynia.";
"Drug use" = "Narkotyki";
"Drugs such as cocaine and amphetamines can trigger a stroke, even in young people." = "Narkotyki takie jak kokaina i amfetamina mogą wywołać udar, nawet u młodych osób.";

/* Prevention */
"Lower your risk" = "Zmniejsz ryzyko";
"Most strokes are linked to risk factors you can manage. These habits help at any age." = "Większość udarów wiąże się z czynnikami ryzyka, na które masz wpływ. Te nawyki pomagają w każdym wieku.";
"Control blood pressure" = "Kontroluj ciśnienie";
"Check it regularly and take medicine as prescribed." = "Mierz je regularnie i przyjmuj leki zgodnie z zaleceniami.";
"Manage blood sugar" = "Kontroluj cukier";
"Keep diabetes under control with your care team." = "Kontroluj cukrzycę razem z zespołem medycznym.";
"Manage cholesterol" = "Kontroluj cholesterol";
"Ask your doctor how often to get it checked." = "Zapytaj lekarza, jak często go badać.";
"Quit smoking and tobacco" = "Rzuć palenie";
"Your risk starts dropping soon after you quit." = "Ryzyko zaczyna spadać wkrótce po rzuceniu.";
"Stay active" = "Bądź aktywny";
"Aim for about 30 minutes of moderate activity most days." = "Staraj się o około 30 minut umiarkowanego ruchu przez większość dni.";
"Eat a heart-healthy diet" = "Jedz zdrowo dla serca";
"More vegetables, fruit and whole grains; less salt and processed food." = "Więcej warzyw, owoców i pełnego ziarna; mniej soli i przetworzonej żywności.";
"Keep a healthy weight" = "Utrzymuj zdrową wagę";
"Even modest weight loss can lower blood pressure." = "Nawet niewielka utrata wagi może obniżyć ciśnienie.";
"Sleep well" = "Wysypiaj się";
"Aim for 7 to 9 hours, and get checked if you snore heavily." = "Śpij 7–9 godzin i zbadaj się, jeśli mocno chrapiesz.";

/* Treatments */
"Treatment depends on the type of stroke and how quickly it begins. The sooner, the better." = "Leczenie zależy od rodzaju udaru i od tego, jak szybko się zacznie. Im wcześniej, tym lepiej.";
"Clot-dissolving medicine" = "Leki rozpuszczające skrzepy";
"Medicine given through an IV to break up a clot." = "Lek podawany dożylnie, aby rozpuścić skrzep.";
"For ischemic stroke, a clot-dissolving medicine such as tPA can restore blood flow to the brain." = "W udarze niedokrwiennym lek rozpuszczający skrzepy, taki jak tPA, może przywrócić przepływ krwi do mózgu.";
"Works best when started within 3 to 4.5 hours of the first symptoms." = "Działa najlepiej, gdy poda się go w ciągu 3–4,5 godziny od pierwszych objawów.";
"Can improve recovery and reduce disability." = "Może poprawić powrót do zdrowia i zmniejszyć niepełnosprawność.";
"Not used when there is a high risk of bleeding, such as after recent surgery." = "Nie stosuje się go przy dużym ryzyku krwawienia, np. po niedawnej operacji.";
"Mechanical thrombectomy" = "Trombektomia mechaniczna";
"A catheter procedure to remove a large clot." = "Zabieg z użyciem cewnika, aby usunąć duży skrzep.";
"A thin tube is guided through an artery to the brain, where doctors remove the clot directly." = "Cienką rurkę wprowadza się tętnicą aż do mózgu, gdzie lekarze bezpośrednio usuwają skrzep.";
"Can be done up to 24 hours after symptoms start for some patients." = "U niektórych pacjentów można ją wykonać do 24 godzin od początku objawów.";
"Often used together with clot-dissolving medicine for strokes in large arteries." = "Przy udarach w dużych tętnicach często łączy się ją z lekami rozpuszczającymi skrzepy.";
"Restores blood flow quickly to limit brain damage." = "Szybko przywraca przepływ krwi, aby ograniczyć uszkodzenie mózgu.";
"Surgery for bleeding" = "Operacja przy krwawieniu";
"Procedures to stop bleeding and relieve pressure." = "Zabiegi, które zatrzymują krwawienie i zmniejszają ucisk.";
"In a hemorrhagic stroke, surgery may be needed to stop the bleeding and lower pressure on the brain." = "W udarze krwotocznym może być potrzebna operacja, aby zatrzymać krwawienie i zmniejszyć ucisk na mózg.";
"An aneurysm can be clipped or coiled to seal the bleeding vessel." = "Tętniak można zamknąć klipsem lub spiralami (coils), aby uszczelnić krwawiące naczynie.";
"A craniotomy can remove pooled blood and relieve pressure." = "Kraniotomia pozwala usunąć zebraną krew i zmniejszyć ucisk.";
"Quick treatment helps prevent further brain injury." = "Szybkie leczenie pomaga zapobiec dalszemu uszkodzeniu mózgu.";
"Rehabilitation" = "Rehabilitacja";
"Therapy to regain skills after a stroke." = "Terapia, która pomaga odzyskać umiejętności po udarze.";
"Recovery often continues for months. Rehabilitation helps people relearn movement, speech and everyday tasks." = "Powrót do zdrowia często trwa miesiącami. Rehabilitacja pomaga na nowo nauczyć się ruchu, mowy i codziennych czynności.";
"May include physical, occupational and speech therapy." = "Może obejmować fizjoterapię, terapię zajęciową i logopedię.";
"Starting early, while still in the hospital, tends to help." = "Wczesne rozpoczęcie, jeszcze w szpitalu, zwykle pomaga.";
"Family and caregivers are an important part of recovery." = "Rodzina i opiekunowie są ważną częścią powrotu do zdrowia.";


/* B.E. F.A.S.T. */
"Stroke symptoms come on suddenly. If you notice any one of these signs, call 911 or your local emergency number immediately. Fast treatment can save brain function." = "स्ट्रोक के लक्षण अचानक आते हैं। इनमें से कोई भी एक लक्षण दिखे तो तुरंत 911 या अपने स्थानीय आपातकालीन नंबर (भारत में 112 या 108) पर कॉल करें। जल्दी इलाज से दिमाग़ के काम बच सकते हैं।";
"Sudden loss of balance or coordination, dizziness, or trouble walking." = "अचानक संतुलन या तालमेल खोना, चक्कर आना या चलने में दिक्कत।";
"Sudden blurred or double vision, or loss of vision in one or both eyes." = "अचानक धुंधला या दोहरा दिखना, या एक या दोनों आँखों से दिखना बंद होना।";
"One side of the face droops or feels numb. The smile may look uneven." = "चेहरे का एक तरफ़ लटक जाता है या सुन्न लगता है। मुस्कान टेढ़ी दिख सकती है।";
"Sudden weakness or numbness in an arm or leg, often on one side of the body." = "एक बाँह या पैर में अचानक कमज़ोरी या सुन्नपन, अक्सर शरीर के एक तरफ़।";
"Slurred speech, trouble speaking or understanding, or sudden confusion." = "लड़खड़ाती बोली, बोलने या समझने में दिक्कत, या अचानक उलझन।";
"Call 911 right away, even if the symptoms go away. Note the time they started." = "लक्षण चले जाएँ तब भी तुरंत 911 या अपने स्थानीय आपातकालीन नंबर (भारत में 112 या 108) पर कॉल करें। लक्षण शुरू होने का समय नोट करें।";

/* Types of stroke */
"Types of stroke" = "स्ट्रोक के प्रकार";
"Strokes are caused either by a blockage or by bleeding. A TIA is a temporary warning." = "स्ट्रोक या तो रुकावट से होता है या खून बहने से। TIA एक अस्थायी चेतावनी है।";
"Ischemic stroke" = "इस्केमिक स्ट्रोक";
"The most common type, about 87% of strokes." = "सबसे आम प्रकार, लगभग 87% स्ट्रोक।";
"An ischemic stroke happens when a blood clot or narrowed artery blocks blood flow to part of the brain." = "इस्केमिक स्ट्रोक तब होता है जब खून का थक्का या सिकुड़ी हुई धमनी दिमाग़ के किसी हिस्से तक खून का बहाव रोक देती है।";
"Clot-dissolving medicine works best when given within a few hours of the first symptoms." = "थक्का घोलने वाली दवा पहले लक्षणों के कुछ घंटों के भीतर दी जाए तो सबसे अच्छा काम करती है।";
"Doctors may also remove large clots with a catheter (thrombectomy)." = "डॉक्टर बड़े थक्कों को कैथेटर से निकाल भी सकते हैं (थ्रोम्बेक्टॉमी)।";
"Every minute counts, so call 911 or your local emergency number right away." = "हर मिनट कीमती है, इसलिए तुरंत 911 या अपने स्थानीय आपातकालीन नंबर (भारत में 112 या 108) पर कॉल करें।";
"Hemorrhagic stroke" = "हेमोरेजिक स्ट्रोक";
"Less common, about 13% of strokes, but often more severe." = "कम आम, लगभग 13% स्ट्रोक, पर अक्सर ज़्यादा गंभीर।";
"A hemorrhagic stroke happens when a weakened blood vessel breaks and bleeds into or around the brain, raising pressure and damaging tissue." = "हेमोरेजिक स्ट्रोक तब होता है जब कमज़ोर नस फट जाती है और दिमाग़ के अंदर या आसपास खून बहता है। इससे दबाव बढ़ता है और ऊतक को नुकसान होता है।";
"High blood pressure is a common cause." = "हाई ब्लड प्रेशर एक आम कारण है।";
"Treatment may include lowering blood pressure and surgery to stop the bleeding or relieve pressure." = "इलाज में ब्लड प्रेशर कम करना और खून बहना रोकने या दबाव घटाने के लिए सर्जरी शामिल हो सकती है।";
"Aneurysms can be clipped or coiled to seal the vessel." = "एन्यूरिज़्म को नस बंद करने के लिए क्लिप या कॉइल से ठीक किया जा सकता है।";
"Transient ischemic attack" = "ट्रांज़िएंट इस्केमिक अटैक";
"A \"mini-stroke\" with symptoms that go away." = "एक “मिनी-स्ट्रोक” जिसके लक्षण चले जाते हैं।";
"A TIA is a brief blockage of blood flow to the brain. Its symptoms are the same as a stroke but usually last only minutes." = "TIA दिमाग़ तक खून के बहाव में थोड़ी देर की रुकावट है। इसके लक्षण स्ट्रोक जैसे ही होते हैं, पर आमतौर पर कुछ ही मिनट रहते हैं।";
"A TIA is a warning sign that a stroke may follow." = "TIA एक चेतावनी है कि आगे स्ट्रोक हो सकता है।";
"It needs emergency care, even if the symptoms are gone." = "लक्षण चले जाएँ तब भी इसे आपातकालीन इलाज चाहिए।";
"Treating the cause can prevent a future stroke." = "कारण का इलाज करने से भविष्य में स्ट्रोक रोका जा सकता है।";

/* Risk factors */
"Risk factors" = "जोखिम कारक";
"Some conditions and habits make a stroke more likely. Many of them can be treated or changed." = "कुछ बीमारियाँ और आदतें स्ट्रोक की संभावना बढ़ाती हैं। इनमें से कई का इलाज हो सकता है या इन्हें बदला जा सकता है।";
"High blood pressure" = "हाई ब्लड प्रेशर";
"The leading cause of stroke. Over time it damages and weakens blood vessels." = "स्ट्रोक का सबसे बड़ा कारण। समय के साथ यह नसों को नुकसान पहुँचाता है और कमज़ोर करता है।";
"Diabetes" = "डायबिटीज़";
"High blood sugar damages blood vessels and makes clots more likely." = "हाई ब्लड शुगर नसों को नुकसान पहुँचाती है और थक्के बनने की संभावना बढ़ाती है।";
"Heart disease" = "दिल की बीमारी";
"Conditions such as atrial fibrillation (AFib) can cause clots that travel to the brain." = "एट्रियल फ़िब्रिलेशन जैसी स्थितियों से थक्के बन सकते हैं जो दिमाग़ तक पहुँच जाते हैं।";
"Smoking" = "धूम्रपान";
"Damages blood vessels and raises blood pressure." = "नसों को नुकसान पहुँचाता है और ब्लड प्रेशर बढ़ाता है।";
"Sleep apnea" = "स्लीप एपनिया";
"Repeated pauses in breathing during sleep strain the heart and blood vessels." = "नींद में बार-बार साँस रुकने से दिल और नसों पर ज़ोर पड़ता है।";
"Drug use" = "नशीले पदार्थों का सेवन";
"Drugs such as cocaine and amphetamines can trigger a stroke, even in young people." = "कोकीन और एम्फ़ेटामीन जैसे नशीले पदार्थ युवाओं में भी स्ट्रोक ला सकते हैं।";

/* Prevention */
"Lower your risk" = "अपना खतरा घटाएँ";
"Most strokes are linked to risk factors you can manage. These habits help at any age." = "ज़्यादातर स्ट्रोक ऐसे जोखिम कारकों से जुड़े होते हैं जिन्हें आप संभाल सकते हैं। ये आदतें हर उम्र में मदद करती हैं।";
"Control blood pressure" = "ब्लड प्रेशर नियंत्रित रखें";
"Check it regularly and take medicine as prescribed." = "इसे नियमित जाँचें और दवा डॉक्टर के बताए अनुसार लें।";
"Manage blood sugar" = "ब्लड शुगर संभालें";
"Keep diabetes under control with your care team." = "अपनी डॉक्टरी टीम के साथ डायबिटीज़ नियंत्रण में रखें।";
"Manage cholesterol" = "कोलेस्ट्रॉल संभालें";
"Ask your doctor how often to get it checked." = "डॉक्टर से पूछें कि इसे कितनी बार जाँचना चाहिए।";
"Quit smoking and tobacco" = "धूम्रपान और तंबाकू छोड़ें";
"Your risk starts dropping soon after you quit." = "छोड़ने के कुछ ही समय बाद खतरा घटने लगता है।";
"Stay active" = "सक्रिय रहें";
"Aim for about 30 minutes of moderate activity most days." = "ज़्यादातर दिनों में लगभग 30 मिनट मध्यम गतिविधि करें।";
"Eat a heart-healthy diet" = "दिल के लिए सेहतमंद खाना खाएँ";
"More vegetables, fruit and whole grains; less salt and processed food." = "ज़्यादा सब्ज़ियाँ, फल और साबुत अनाज; कम नमक और प्रोसेस्ड खाना।";
"Keep a healthy weight" = "सेहतमंद वज़न बनाए रखें";
"Even modest weight loss can lower blood pressure." = "थोड़ा वज़न घटाने से भी ब्लड प्रेशर कम हो सकता है।";
"Sleep well" = "अच्छी नींद लें";
"Aim for 7 to 9 hours, and get checked if you snore heavily." = "7 से 9 घंटे सोएँ, और ज़ोर से खर्राटे लेते हों तो जाँच कराएँ।";

/* Treatments */
"Treatment depends on the type of stroke and how quickly it begins. The sooner, the better." = "इलाज स्ट्रोक के प्रकार और इस पर निर्भर करता है कि वह कितनी जल्दी शुरू हुआ। जितना जल्दी, उतना बेहतर।";
"Clot-dissolving medicine" = "थक्का घोलने वाली दवा";
"Medicine given through an IV to break up a clot." = "थक्का तोड़ने के लिए नस में (IV से) दी जाने वाली दवा।";
"For ischemic stroke, a clot-dissolving medicine such as tPA can restore blood flow to the brain." = "इस्केमिक स्ट्रोक में tPA जैसी थक्का घोलने वाली दवा दिमाग़ तक खून का बहाव फिर से चालू कर सकती है।";
"Works best when started within 3 to 4.5 hours of the first symptoms." = "पहले लक्षणों के 3 से 4.5 घंटे के भीतर शुरू करने पर सबसे अच्छा काम करती है।";
"Can improve recovery and reduce disability." = "ठीक होने में मदद कर सकती है और विकलांगता घटा सकती है।";
"Not used when there is a high risk of bleeding, such as after recent surgery." = "खून बहने का खतरा ज़्यादा हो, जैसे हाल ही में सर्जरी हुई हो, तो इसका इस्तेमाल नहीं होता।";
"Mechanical thrombectomy" = "मैकेनिकल थ्रोम्बेक्टॉमी";
"A catheter procedure to remove a large clot." = "बड़ा थक्का निकालने के लिए कैथेटर से की जाने वाली प्रक्रिया।";
"A thin tube is guided through an artery to the brain, where doctors remove the clot directly." = "एक पतली नली धमनी के रास्ते दिमाग़ तक ले जाई जाती है, जहाँ डॉक्टर थक्का सीधे निकाल देते हैं।";
"Can be done up to 24 hours after symptoms start for some patients." = "कुछ मरीज़ों में लक्षण शुरू होने के 24 घंटे तक की जा सकती है।";
"Often used together with clot-dissolving medicine for strokes in large arteries." = "बड़ी धमनियों के स्ट्रोक में अक्सर थक्का घोलने वाली दवा के साथ की जाती है।";
"Restores blood flow quickly to limit brain damage." = "दिमाग़ को कम नुकसान हो, इसके लिए खून का बहाव जल्दी बहाल करती है।";
"Surgery for bleeding" = "खून बहने की सर्जरी";
"Procedures to stop bleeding and relieve pressure." = "खून बहना रोकने और दबाव घटाने की प्रक्रियाएँ।";
"In a hemorrhagic stroke, surgery may be needed to stop the bleeding and lower pressure on the brain." = "हेमोरेजिक स्ट्रोक में खून बहना रोकने और दिमाग़ पर दबाव घटाने के लिए सर्जरी की ज़रूरत पड़ सकती है।";
"An aneurysm can be clipped or coiled to seal the bleeding vessel." = "खून बहती नस को बंद करने के लिए एन्यूरिज़्म को क्लिप या कॉइल किया जा सकता है।";
"A craniotomy can remove pooled blood and relieve pressure." = "क्रेनियोटॉमी से जमा हुआ खून निकाला और दबाव घटाया जा सकता है।";
"Quick treatment helps prevent further brain injury." = "जल्दी इलाज से दिमाग़ को और नुकसान से बचाया जा सकता है।";
"Rehabilitation" = "पुनर्वास";
"Therapy to regain skills after a stroke." = "स्ट्रोक के बाद क्षमताएँ वापस पाने की थेरेपी।";
"Recovery often continues for months. Rehabilitation helps people relearn movement, speech and everyday tasks." = "ठीक होने में अक्सर महीनों लगते हैं। पुनर्वास से लोग चलना-फिरना, बोलना और रोज़मर्रा के काम फिर से सीखते हैं।";
"May include physical, occupational and speech therapy." = "इसमें फ़िज़ियोथेरेपी, ऑक्यूपेशनल थेरेपी और स्पीच थेरेपी शामिल हो सकती है।";
"Starting early, while still in the hospital, tends to help." = "जल्दी शुरू करना, अस्पताल में रहते हुए ही, अक्सर मदद करता है।";
"Family and caregivers are an important part of recovery." = "परिवार और देखभाल करने वाले ठीक होने का अहम हिस्सा हैं।";

